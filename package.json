{
  "name": "eslint-plugin-fsd-boundaries",
  "version": "1.1.0",
  "description": "ESLint plugin that enforces Feature-Sliced Design boundaries: Public API imports, layer direction, and relative-vs-absolute import paths — with autofixes.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "fsd",
    "feature-sliced",
    "feature-sliced-design",
    "architecture",
    "boundaries",
    "public-api",
    "layers"
  ],
  "author": "f1eeman",
  "homepage": "https://github.com/f1eeman/eslint-plugin-fsd-boundary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f1eeman/eslint-plugin-fsd-boundary.git"
  },
  "bugs": {
    "url": "https://github.com/f1eeman/eslint-plugin-fsd-boundary/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.62.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript-eslint/parser": "^8.62.1",
    "@typescript-eslint/rule-tester": "^8.62.1",
    "eslint": "^9.0.0",
    "eslint-plugin-eslint-plugin": "~7.6.2",
    "eslint-plugin-n": "~18.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "peerDependencies": {
    "eslint": ">=9.15.0"
  },
  "license": "MIT"
}
